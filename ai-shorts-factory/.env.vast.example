APP_PORT=7860
COMFYUI_PORT=8188
COMFYUI_PORT_SECOND=8189
COMFYUI_URL=http://127.0.0.1:8188

# Comma-separated ComfyUI HTTP bases (multi-GPU workers). Overrides single COMFYUI_URL when set.
COMFYUI_URLS=http://127.0.0.1:8188,http://127.0.0.1:8189

# Multi-GPU: two separate ComfyUI processes (parallel throughput). Does NOT merge VRAM for one model.
COMFYUI_MULTI_GPU=false
COMFYUI_WORKERS=1

APP_HOST=0.0.0.0

PROJECT_DIR=/workspace/ai-shorts-factory
COMFYUI_DIR=/workspace/ComfyUI

AUTO_START=true
DOWNLOAD_MODELS=false
VIDEO_BACKEND=placeholder

# Fill after pushing the project to GitHub
GITHUB_REPO_URL=https://github.com/YOUR_USERNAME/ai-shorts-factory.git

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
